{
  "name": "chase-os-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chase OS job sourcing agents: ATS-verified postings only, no guessing.",
  "engines": { "node": ">=18" },
  "scripts": {
    "verify": "node scripts/verify-slugs.mjs",
    "pull": "node agents/ats-pull.mjs",
    "pull:targets": "node agents/ats-pull.mjs --targets-only",
    "pull:dry": "node agents/ats-pull.mjs --dry-run",
    "hygiene": "node agents/radar-hygiene.mjs",
    "hygiene:dry": "node agents/radar-hygiene.mjs --dry-run",
    "tiers": "node agents/apply-tiers.mjs",
    "tiers:dry": "node agents/apply-tiers.mjs --dry-run"
  }
}
